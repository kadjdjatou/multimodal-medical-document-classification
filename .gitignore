# ==============================================================================
# Git Ignore - Multimodal Medical Document Classification
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Model Weights & Large Binary Checkpoints (> 90 MB each, up to ~450 MB)
# To preserve the folder structure, only weights/README.md is tracked
weights/*
!weights/README.md

# OCR binaries (Tesseract Windows portable installation)
Tesseract-OCR/
tesseract-ocr/

# Environment variables & secrets
.env
.env.*
*.env

# IDEs & Editors configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# Jupyter Notebook checkpoints & autosaves
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs and temporary scratch files
*.log
*.tmp
*.temp
scratch/
